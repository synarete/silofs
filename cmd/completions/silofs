_silofs_subcmd() {
	local cur prev words cword
	_init_completion || return

	case "${words[1]}" in
		"init")
			_silofs_init
			;;
		"mkfs")
			_silofs_mkfs
			;;
		"mount")
			_silofs_mount
			;;
		"umount")
			_silofs_umount
			;;
		"lsmnt")
			_silofs_lsmnt
			;;
		"show")
			_silofs_show
			;;
		"clone")
			_silofs_clone
			;;
		"sync")
			_silofs_sync
			;;
		"tune")
			_silofs_tune
			;;
		"rmfs")
			_silofs_rmfs
			;;
		"prune")
			_silofs_prune
			;;
		"fsck")
			_silofs_fsck
			;;
		"view")
			_silofs_view
			;;
		"archive")
			_silofs_archive
			;;
		"restore")
			_silofs_restore
			;;
	esac
}

_silofs_main() {
	local cur prev words cword
	_init_completion || return

	if [[ "$cur" == -* ]]; then
		COMPREPLY+=( $(compgen -W '-v --version ' -- "$cur") )
		COMPREPLY+=( $(compgen -W '-h --help' -- "$cur") )
	else
		COMPREPLY+=( $(compgen -W 'init ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'mkfs ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'mount ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'umount ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'lsmnt ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'show ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'clone ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'sync ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'tune ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'rmfs ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'prune ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'fsck ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'view ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'archive ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'restore ' -- "$cur") )
	fi
}

_silofs_completions() {
	local IFS=$' \t\n'
	# shellcheck disable=SC2034
	local cur prev words cword

	_init_completion || return

	compopt -o nospace
	COMPREPLY=( "${COMPREPLY[@]:-}" )

	if [[ $cword -eq 1 ]]; then
		_silofs_main
	else
		_silofs_subcmd
	fi
}

complete -o bashdefault -o default -o nospace -F _silofs_completions silofs

