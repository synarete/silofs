# -*- mode: sh; sh-shell: bash; -*-
# silofs(1) bash completion
# shellcheck shell=bash

[ -z "$BASH_VERSION" ] && return

_silofs_complete_options() {
	local options="$1"

	if [[ "$cur" == *=* ]]; then
		return
	fi
	mapfile -t COMPREPLY < <(compgen -W "$options" -- "$cur")

	# don't add a space if match ends with '='
	if [[ ${#COMPREPLY[@]} -eq 1 && ${COMPREPLY[0]} == *= ]]; then
		compopt -o nospace
	fi
}

_silofs_complete_subcmds() {
	local subcmds="$1"

	mapfile -t COMPREPLY < <(compgen -W "$subcmds" -- "$cur")
}

_silofs_complete_filedir() {
	# reset nospace in case it was set by an option check
	compopt +o nospace 2>/dev/null
	_filedir "$@"
}

_silofs_complete_file() {
	_silofs_complete_filedir -f
}

_silofs_complete_dir() {
	_silofs_complete_filedir -d
}

_silofs_init() {
	local options=""

	if [[ "$cur" == -* ]]; then
		options+="-u --user= "
		options+="-L --loglevel= "
		options+="-h --help "
		_silofs_complete_options "$options"
	else
		_silofs_complete_dir
	fi
}

_silofs_mkfs() {
	local options=""

	if [[ "$cur" == -* ]]; then
		options+="-s --size= "
		options+="-u --user= "
		options+="-G --sup-groups "
		options+="-R --allow-root "
		options+="-N --no-utf8-names "
		options+="-L --loglevel= "
		options+="-h --help "
		_silofs_complete_options "$options"
	else
		_silofs_complete_dir -d
	fi
}

