		COMPREPLY+=( $(compgen -W 'version ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'repo ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'boot ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'proc ' -- "$cur") )
		COMPREPLY+=( $(compgen -W 'statx ' -- "$cur") )
