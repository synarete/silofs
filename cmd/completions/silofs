_silofs_subcmd() {
	case "${words[1]}" in
		"init")    _silofs_init    ;;
		"mkfs")    _silofs_mkfs    ;;
		"mount")   _silofs_mount   ;;
		"umount")  _silofs_umount  ;;
		"lsmnt")   _silofs_lsmnt   ;;
		"show")    _silofs_show    ;;
		"clone")   _silofs_clone   ;;
		"sync")    _silofs_sync    ;;
		"tune")    _silofs_tune    ;;
		"rmfs")    _silofs_rmfs    ;;
		"prune")   _silofs_prune   ;;
		"fsck")    _silofs_fsck    ;;
		"view")    _silofs_view    ;;
		"archive") _silofs_archive ;;
		"restore") _silofs_restore ;;
	esac
}

_silofs_main() {
	local options=""
	local subcmds=""

	if [[ "$cur" == -* ]]; then
		options+="-v --version "
		options+="-h --help "
		_silofs_complete_options "$options"
	else
		subcmds+="init mkfs mount umount lsmnt show sync clone "
		subcmds+="tune rmfs prune fsck view preserve restore "
		_silofs_complete_subcmds "$subcmds"
	fi
}

_silofs_completions() {
	local IFS=$' \t\n'
	# shellcheck disable=SC2034
	local cur prev words cword

	# require bash-completion helpers
	command -v _init_completion >/dev/null 2>&1 || return

	_init_completion || return

	if [[ $cword -eq 1 ]]; then
		_silofs_main
	else
		_silofs_subcmd
	fi
}

complete -o filenames -o bashdefault -o default -F _silofs_completions silofs

